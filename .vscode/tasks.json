{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "core:configure",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				"engine",
				"-B",
				"engine/build",
				"-DCMAKE_BUILD_TYPE=Release"
			],
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "core:build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"engine/build",
				"--config",
				"Release",
				"--parallel"
			],
			"dependsOn": [
				"core:configure"
			],
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "core:test",
			"type": "shell",
			"command": "node",
			"args": [
				"scripts/test-core.mjs"
			],
			"dependsOn": [
				"core:build"
			]
		},
		{
			"label": "npm:build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"group": "build",
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "npm:test",
			"type": "shell",
			"command": "npm",
			"args": [
				"test"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "depscan:package",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"package"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "stress:clean",
			"type": "shell",
			"command": "node",
			"args": [
				"scripts/clean-stress.mjs"
			],
			"problemMatcher": []
		},
		{
			"label": "samples:clean",
			"type": "shell",
			"command": "node",
			"args": [
				"scripts/clean-sample.mjs"
			],
			"problemMatcher": []
		}
	]
}
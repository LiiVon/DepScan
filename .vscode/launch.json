{
  "version": "0.1.0",
  "configurations": [
    {
      "name": "运行 DepScaner 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/samples/demo"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "调试 C++ 引擎（对 samples/demo 扫描）",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/engine/build/bin/Release/depscaner-core.exe",
      "args": ["--once", "--root", "${workspaceFolder}/samples/demo", "--pretty"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "core:build"
    }
  ]
}
